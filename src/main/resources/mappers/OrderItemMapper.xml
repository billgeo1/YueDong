<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.xiangmu.mappers.OrderItemMapper">
  
  
   <insert id="insert" useGeneratedKeys="true" keyProperty="id">
       insert into t_order_item(
            <!--id-->
            orderId,
			productId,
			title,
			
			jiage,
			shuliang
       ) values 
       (
            <!--#{id},-->
            #{orderId},
			#{productId},
			#{title},
			
			#{jiage},
			#{shuliang}
       )
   </insert>
   
   
   
  <delete id="deleteByOrderId">
      delete from t_order_item where orderId=#{orderId}
  </delete>
  
   
   
  
   
   
   <select id="selectByOrderId" resultType="com.xiangmu.pojo.OrderItem">
       select * from t_order_item where orderId=#{orderId} 
   </select>
   
   
   <select id="selectByProductId" resultType="com.xiangmu.pojo.OrderItem">
       select * from t_order_item where productId=#{productId} 
   </select>
</mapper>

  
  
