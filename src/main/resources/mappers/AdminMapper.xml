<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
<mapper namespace="com.xiangmu.mappers.AdminMapper">
  
   
   
   
  <!-- public List select(String username); -->
  <select id="select" resultType="com.xiangmu.pojo.Admin">
      select * from t_admin where username=#{username}
  </select>
   
   
  <!-- public int updateAdminPass(String newPass,int id); -->
  <update id="updateAdminPass">
       update t_admin set password = #{newPass} where id=#{id}
  </update>
   
</mapper>

  
  
